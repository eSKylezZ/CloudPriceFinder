.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local development data
TempData/
temp/
*.tmp
.env

# Generated data files (regenerated by aggregator, Stage 6)
data/all_instances.json
data/summary.json
data/oci.json
# Provider data files (generated at runtime)
data/providers/*.json
data/providers/*.raw.json
# Exception: archived v2 secondary-provider data stays in git for v3.1 re-activation
!data/providers/_archive/
!data/providers/_archive/**
scripts/data/all_instances.json
scripts/data/summary.json

# Test coverage
coverage/
.nyc_output/
*.lcov

# Local configuration
.claude/settings.local.json
config.local.json
.claude/worktrees/*
.gitignore.local


# Local archive folder (developer-only files, not shipped)
local/

# Backup files
*.bak
*.backup

# Local scripts (for development use only)
scripts/local_*
scripts/test_*

# Documentation drafts
docs/drafts/
*.draft.md