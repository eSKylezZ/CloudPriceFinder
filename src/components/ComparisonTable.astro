  // ---------------------------------------------------------------------------
  // Sort headers
  // ---------------------------------------------------------------------------
  function updateSortAriaLabels() {
    document.getElementById('instances-table')?.querySelectorAll<HTMLElement>('th[data-sort]').forEach((th) => {
      const field = th.getAttribute('data-sort')!;
      if (field === currentSortField) {
        th.setAttribute('aria-sort', currentSortDir === 'asc' ? 'ascending' : 'descending');
      } else {
        th.setAttribute('aria-sort', 'none');
      }
    });
  }

  function handleSortClick(th: Element) {
    const field = th.getAttribute('data-sort')!;
    if (currentSortField === field) {
      currentSortDir = currentSortDir === 'asc' ? 'desc' : 'asc';
    } else {
      currentSortField = field;
      currentSortDir   = 'asc';
    }
    updateSortAriaLabels();
    sortAndRender();
  }

  document.getElementById('instances-table')?.querySelectorAll('th[data-sort]').forEach((th) => {
    th.addEventListener('click', () => handleSortClick(th));
    th.addEventListener('keydown', (e: Event) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'Enter' || ke.key === ' ') {
        ke.preventDefault();
        handleSortClick(th);
      }
    });
  });

  window.addEventListener('requestResetSort', () => {
    currentSortField = 'priceUSD_hourly';
    currentSortDir   = 'asc';
    updateSortAriaLabels();
    // sortAndRender() will be triggered by the filtersChanged event that follows
  });

