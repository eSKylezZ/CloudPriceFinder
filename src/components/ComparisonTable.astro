    'databases': [
      { key: 'provider', label: 'Provider', fmt: (v) => String(v ?? '').toUpperCase() },
      { key: 'instanceType', label: 'Instance' },
      { key: 'engine', label: 'Engine', fmt: (v) => String(v ?? '—') },
      { key: 'deploymentOption', label: 'Deployment', fmt: (v) => String(v ?? '—') },
      { key: 'vCPU', label: 'vCPU', extraClass: 'font-mono tabular-nums', fmt: (v) => v != null ? String(v) : '—' },
      { key: 'memoryGiB', label: 'Memory', extraClass: 'font-mono tabular-nums', fmt: (v) => v != null ? `${v} GiB` : '—' },
      { key: 'priceUSD_hourly', label: '$/hr', extraClass: 'font-mono tabular-nums', fmt: (v) => v != null ? `$${Number(v).toFixed(4)}` : '—' },
      { key: 'priceUSD_monthly', label: '$/mo', extraClass: 'font-mono tabular-nums font-semibold', fmt: (v) => v != null ? `$${Number(v).toFixed(2)}` : '—' },
    ],
    'ai-ml': [
      { key: 'provider', label: 'Provider', fmt: (v) => String(v ?? '').toUpperCase() },
      { key: 'instanceType', label: 'Model ID' },
      { key: 'modelName', label: 'Name', extraClass: 'max-w-xs truncate', fmt: (v) => String(v ?? '—') },
      { key: 'modality', label: 'Modality', fmt: (v) => String(v ?? '—') },
      { key: 'pricePerMInputTokens', label: '$/M In', extraClass: 'font-mono tabular-nums', fmt: (v) => v != null ? `$${Number(v).toFixed(2)}` : '—' },
      { key: 'pricePerMOutputTokens', label: '$/M Out', extraClass: 'font-mono tabular-nums', fmt: (v) => v != null ? `$${Number(v).toFixed(2)}` : '—' },
      { key: 'contextWindowK', label: 'Context', extraClass: 'font-mono tabular-nums', fmt: (v) => v != null ? `${v}K` : '—' },
    ],
    'object-storage': [
      { key: 'provider', label: 'Provider', fmt: (v) => String(v ?? '').toUpperCase() },
      { key: 'storageClass', label: 'Storage Class', fmt: (v) => String(v ?? '—') },
      { key: 'redundancy', label: 'Redundancy', fmt: (v) => v != null ? String(v) : '—' },
      { key: 'minPricePerGiBMonth', label: 'Min $/GiB/mo', extraClass: 'font-mono tabular-nums', fmt: (v) => v != null ? `$${Number(v).toFixed(4)}` : '—' },
      { key: 'maxPricePerGiBMonth', label: 'Max $/GiB/mo', extraClass: 'font-mono tabular-nums', fmt: (v) => v != null ? `$${Number(v).toFixed(4)}` : '—' },
      { key: 'regions', label: 'Regions', extraClass: 'font-mono tabular-nums', fmt: (v) => Array.isArray(v) ? String(v.length) : '—' },
    ],
  };

  let productsIndexData: ProductsIndex | null = null;
  let allProductItems: ProductItem[] = [];
  let filteredProductItems: ProductItem[] = [];
  let productsPage = 1;
  const PRODUCTS_PAGE_SIZE = 50;

  async function showProductsTable(category: string) {
    const section = document.getElementById('products-section')!;
    const pLoading = document.getElementById('products-loading')!;
    const pWrapper = document.getElementById('products-table-wrapper')!;
    const pEmpty = document.getElementById('products-empty')!;
    const pPagination = document.getElementById('products-pagination')!;

    tableLoading.classList.add('hidden');
    tableWrapper.classList.add('hidden');
    tableEmpty.classList.add('hidden');
    paginationControls.classList.add('hidden');
    document.getElementById('badge-legend')?.classList.add('hidden');
    document.getElementById('service-coming-soon')?.classList.add('hidden');

    section.classList.remove('hidden');
    pLoading.classList.remove('hidden');
    pWrapper.classList.add('hidden');
    pEmpty.classList.add('hidden');
    pPagination.classList.add('hidden');
    if (resultCount) resultCount.textContent = '';

    const calcEl = document.getElementById('block-storage-calculator');
    if (calcEl) calcEl.classList.toggle('hidden', category !== 'block-storage');

    const productKey = CATEGORY_PRODUCT_KEY[category];
    if (!productKey) {
      section.classList.add('hidden');
      showComingSoon(category);
      return;
    }

    if (!productsIndexData) {
      const resp = await fetch('/data/products/index.json');
      productsIndexData = (await resp.json()) as ProductsIndex;
    }

    const items: ProductItem[] = [];
    const providers = productsIndexData.providers;
    await Promise.all(
      Object.values(providers)
        .filter((pd) => pd[productKey])
        .map(async (pd) => {
          const resp = await fetch(`/data/${pd[productKey].file}`);
          const data: ProductItem[] = await resp.json();
          items.push(...data);
        })
    );

    allProductItems = items;
    productsPage = 1;
    pLoading.classList.add('hidden');
    applyAndRenderProducts();

    const providerCounts: Record<string, number> = {};
    for (const item of allProductItems) {
      if (item.provider) providerCounts[item.provider] = (providerCounts[item.provider] ?? 0) + 1;
    }
    window.dispatchEvent(new CustomEvent('productProvidersLoaded', { detail: { providerCounts } }));
  }

  function applyAndRenderProducts(selectedProviders?: string[], selectedRegions?: string[]) {
    filteredProductItems = allProductItems.filter((item) => {
      if (selectedProviders?.length && !selectedProviders.includes(item.provider ?? '')) return false;
      if (selectedRegions?.length && Array.isArray(item.regions)) {
        const regions = item.regions as string[];
        if (!selectedRegions.some((r: string) => regions.includes(r))) return false;
      }
      if (searchTerm) {
        const haystack = [
          item.provider, item.instanceType, item.storageClass, item.modelName,
          item.engine, item.modality, item.storageMedia, item.deploymentOption,
        ].filter(Boolean).join(' ').toLowerCase();
        if (!haystack.includes(searchTerm)) return false;
      }
      return true;
    });
    productsPage = 1;
    renderProductsPage();
  }

  // Primary price key for heatmap per product category
  const PRODUCT_PRICE_KEY: Record<string, string> = {
    'block-storage':  'priceUSD_monthly',
    'databases':      'priceUSD_hourly',
    'ai-ml':          'pricePerMInputTokens',
    'object-storage': 'minPricePerGiBMonth',
  };

  function renderProductsPage() {
    const category = activeServiceCategory;
    const columns = PRODUCT_COLUMNS[category];
    if (!columns) return;

    const thead = document.getElementById('products-thead')!;
    const tbody = document.getElementById('products-tbody')!;
    const productsMobileCards = document.getElementById('products-mobile-cards')!;
    const pWrapper = document.getElementById('products-table-wrapper')!;
    const pEmpty = document.getElementById('products-empty')!;
    const pPagination = document.getElementById('products-pagination')!;

    if (filteredProductItems.length === 0) {
      pWrapper.classList.add('hidden');
      if (productsMobileCards) productsMobileCards.innerHTML = '';
      pEmpty.classList.remove('hidden');
      pPagination.classList.add('hidden');
      if (resultCount) resultCount.textContent = '0 items';
      return;
    }

    pEmpty.classList.add('hidden');
    pWrapper.classList.remove('hidden');

    const total = filteredProductItems.length;
    const totalPages = Math.ceil(total / PRODUCTS_PAGE_SIZE);
    if (productsPage > totalPages) productsPage = totalPages;
    const start = (productsPage - 1) * PRODUCTS_PAGE_SIZE;
    const end = Math.min(start + PRODUCTS_PAGE_SIZE, total);
    const pageItems = filteredProductItems.slice(start, end);

    // Compute heatmap min/max across full filtered set (not just current page)
    const heatKey = PRODUCT_PRICE_KEY[category];
    const heatVals = filteredProductItems
      .map(item => { const v = item[heatKey] as number | null | undefined; return v != null ? Number(v) : NaN; })
      .filter(n => !isNaN(n) && n > 0);
    const heatMin = heatVals.length ? Math.min(...heatVals) : 0;
    const heatMax = heatVals.length ? Math.max(...heatVals) : 0;

    // Compute table header — compute style
    thead.innerHTML = `<tr class="bg-slate-100 border-b-2 border-slate-200">${columns.map((c) =>
      `<th scope="col" class="px-3 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider sticky top-0 bg-slate-100 z-10 whitespace-nowrap">${c.label}</th>`
    ).join('')}</tr>`;

    // Render rows with provider badges, zebra stripes, and price heatmap
    tbody.innerHTML = pageItems.map((item, i) => {
      const cells = columns.map((col) => {
        const val = item[col.key];
        let display: string;
        if (col.key === 'provider') {
          const prov = String(val ?? '').toLowerCase();
          display = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold leading-snug ${providerColor(prov)}">${String(val ?? '').toUpperCase()}</span>`;
        } else {
          display = col.fmt ? col.fmt(val) : (val != null ? String(val) : '—');
        }
        let heatStyle = '';
        if (col.key === heatKey && heatMax > heatMin && val != null) {
          const n = Number(val);
          if (!isNaN(n) && n > 0) {
            const t = (n - heatMin) / (heatMax - heatMin);
            const hue = Math.round(130 - t * 102);
            heatStyle = ` style="background-color:hsl(${hue},62%,72%);color:#1f2937;"`;
          }
        }
        const cls = `px-3 py-2.5 whitespace-nowrap${col.extraClass ? ' ' + col.extraClass : ''}`;
        return `<td class="${cls}"${heatStyle}>${display}</td>`;
      }).join('');
      const rowCls = i % 2 === 0 ? 'bg-white hover:bg-blue-50/40' : 'bg-slate-50 hover:bg-blue-50/40';
      return `<tr class="transition-colors ${rowCls}">${cells}</tr>`;
    }).join('');

    // Mobile cards
    if (productsMobileCards) {
      productsMobileCards.innerHTML = pageItems.map((item, i) =>
        buildProductCard(item, category, i % 2 === 0, heatMin, heatMax)
      ).join('');
    }

    if (resultCount) resultCount.textContent = `${total.toLocaleString()} items`;

    const infoEl = document.getElementById('products-pagination-info');
    if (infoEl) infoEl.textContent = `Showing ${start + 1}–${end} of ${total.toLocaleString()}`;

    const pageInfoEl = document.getElementById('products-page-info');
    if (pageInfoEl) pageInfoEl.textContent = `Page ${productsPage} of ${totalPages}`;

    const prevBtn = document.getElementById('products-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('products-next-btn') as HTMLButtonElement | null;
    if (prevBtn) prevBtn.disabled = productsPage <= 1;
    if (nextBtn) nextBtn.disabled = productsPage >= totalPages;

    pPagination.classList.toggle('hidden', total <= PRODUCTS_PAGE_SIZE);
  }

  function buildProductCard(item: ProductItem, category: string, isEven: boolean, heatMin: number, heatMax: number): string {
    const provider = String(item.provider ?? '').toLowerCase();
    const provBadge = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold ${providerColor(provider)}">${provider.toUpperCase()}</span>`;

    function heatInline(val: number | null | undefined): string {
      if (val == null || isNaN(val) || val <= 0 || heatMax <= heatMin) return '';
      const t = (val - heatMin) / (heatMax - heatMin);
      const hue = Math.round(130 - t * 102);
      return ` style="background-color:hsl(${hue},62%,72%);color:#1f2937;padding:2px 6px;border-radius:4px;"`;
    }

    if (category === 'block-storage') {
      const price = item.priceUSD_monthly != null ? Number(item.priceUSD_monthly) : null;
      const priceStr = price != null ? `$${price.toFixed(4)}/GiB/mo` : '—';
      const estMonthly = price != null ? price * blockStorageGiB : null;
      const estStr = estMonthly != null ? `≈$${estMonthly.toFixed(2)}/mo for ${blockStorageGiB} GiB` : '';
      return `<div class="px-4 py-3 ${isEven ? 'bg-gray-50' : 'bg-white'}">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center flex-wrap gap-1.5 mb-1.5">${provBadge}</div>
            <div class="font-medium text-sm text-gray-900 truncate">${item.instanceType ?? '—'}</div>
            <div class="flex flex-wrap items-center gap-3 mt-1.5 text-sm">
              ${item.storageMedia ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs bg-gray-100 text-gray-700">${item.storageMedia}</span>` : ''}
              ${item.maxIops != null ? `<span class="text-gray-600"><span class="text-[11px] text-gray-400 mr-0.5">IOPS</span>${Number(item.maxIops).toLocaleString()}</span>` : ''}
              ${item.maxThroughputMBps != null ? `<span class="text-gray-600"><span class="text-[11px] text-gray-400 mr-0.5">Throughput</span>${item.maxThroughputMBps} MB/s</span>` : ''}
            </div>
          </div>
          <div class="text-right shrink-0">
            <div class="text-base font-bold tabular-nums leading-tight"${heatInline(price)}>${priceStr}</div>
            ${estStr ? `<div class="text-xs font-semibold text-blue-700 mt-0.5">${estStr}</div>` : ''}
            ${Array.isArray(item.regions) ? `<div class="text-xs text-gray-400 mt-1">${item.regions.length} regions</div>` : ''}
          </div>
        </div>
      </div>`;
    }

    if (category === 'databases') {
      const price = item.priceUSD_hourly != null ? Number(item.priceUSD_hourly) : null;
      const priceStr = price != null ? `$${price.toFixed(4)}/hr` : '—';
      const monthly = item.priceUSD_monthly != null ? Number(item.priceUSD_monthly) : null;
      const monthlyStr = monthly != null ? `$${monthly.toFixed(2)}/mo` : '';
      return `<div class="px-4 py-3 ${isEven ? 'bg-gray-50' : 'bg-white'}">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center flex-wrap gap-1.5 mb-1.5">${provBadge}${item.engine ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs bg-gray-100 text-gray-700">${item.engine}</span>` : ''}</div>
            <div class="font-medium text-sm text-gray-900 font-mono truncate">${item.instanceType ?? '—'}</div>
            ${item.deploymentOption ? `<div class="text-xs text-gray-500 mt-0.5">${item.deploymentOption}</div>` : ''}
            <div class="flex flex-wrap items-center gap-3 mt-1.5 text-sm">
              ${item.vCPU != null ? `<span class="text-gray-600"><span class="text-[11px] text-gray-400 mr-0.5">vCPU</span>${item.vCPU}</span>` : ''}
              ${item.memoryGiB != null ? `<span class="text-gray-600"><span class="text-[11px] text-gray-400 mr-0.5">RAM</span>${item.memoryGiB} GiB</span>` : ''}
            </div>
          </div>
          <div class="text-right shrink-0">
            <div class="text-base font-bold tabular-nums leading-tight"${heatInline(price)}>${priceStr}</div>
            ${monthlyStr ? `<div class="text-xs font-semibold text-gray-600 mt-0.5">${monthlyStr}</div>` : ''}
          </div>
        </div>
      </div>`;
    }

    if (category === 'ai-ml') {
      const priceIn = item.pricePerMInputTokens != null ? Number(item.pricePerMInputTokens) : null;
      const priceOut = item.pricePerMOutputTokens != null ? Number(item.pricePerMOutputTokens) : null;
      const priceInStr = priceIn != null ? `$${priceIn.toFixed(2)}/M in` : '—';
      const priceOutStr = priceOut != null ? `$${priceOut.toFixed(2)}/M out` : '';
      return `<div class="px-4 py-3 ${isEven ? 'bg-gray-50' : 'bg-white'}">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center flex-wrap gap-1.5 mb-1.5">${provBadge}${item.modality ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs bg-gray-100 text-gray-700">${item.modality}</span>` : ''}</div>
            <div class="font-medium text-sm text-gray-900 font-mono truncate">${item.instanceType ?? '—'}</div>
            ${item.modelName ? `<div class="text-xs text-gray-500 mt-0.5 truncate">${item.modelName}</div>` : ''}
            ${item.contextWindowK != null ? `<div class="text-xs text-gray-500 mt-1"><span class="text-gray-400 mr-0.5">Context</span>${item.contextWindowK}K tokens</div>` : ''}
          </div>
          <div class="text-right shrink-0">
            <div class="text-sm font-semibold tabular-nums leading-tight"${heatInline(priceIn)}>${priceInStr}</div>
            ${priceOutStr ? `<div class="text-xs text-gray-500 mt-0.5">${priceOutStr}</div>` : ''}
          </div>
        </div>
      </div>`;
    }

    if (category === 'object-storage') {
      const price = item.minPricePerGiBMonth != null ? Number(item.minPricePerGiBMonth) : null;
      const priceStr = price != null ? `$${price.toFixed(4)}/GiB/mo` : '—';
      const maxPriceStr = item.maxPricePerGiBMonth != null && item.maxPricePerGiBMonth !== item.minPricePerGiBMonth
        ? `up to $${Number(item.maxPricePerGiBMonth).toFixed(4)}`
        : '';
      return `<div class="px-4 py-3 ${isEven ? 'bg-gray-50' : 'bg-white'}">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center flex-wrap gap-1.5 mb-1.5">${provBadge}</div>
            <div class="font-medium text-sm text-gray-900 truncate">${item.storageClass ?? '—'}</div>
            ${item.redundancy ? `<div class="text-xs text-gray-500 mt-0.5">${item.redundancy}</div>` : ''}
          </div>
          <div class="text-right shrink-0">
            <div class="text-base font-bold tabular-nums leading-tight"${heatInline(price)}>${priceStr}</div>
            ${maxPriceStr ? `<div class="text-xs text-gray-400 mt-0.5">${maxPriceStr}</div>` : ''}
            ${Array.isArray(item.regions) ? `<div class="text-xs text-gray-400 mt-1">${item.regions.length} regions</div>` : ''}
          </div>
        </div>
      </div>`;
    }

    return '';
  }

  function hideProductsSection() {
    document.getElementById('products-section')?.classList.add('hidden');
    document.getElementById('block-storage-calculator')?.classList.add('hidden');
    const mobileCards = document.getElementById('products-mobile-cards');
    if (mobileCards) mobileCards.innerHTML = '';
    allProductItems = [];
    filteredProductItems = [];
    window.dispatchEvent(new CustomEvent('productProvidersLoaded', { detail: { providerCounts: null } }));
  }

  document.getElementById('products-prev-btn')?.addEventListener('click', () => {
    if (productsPage > 1) { productsPage--; renderProductsPage(); }
  });
  document.getElementById('products-next-btn')?.addEventListener('click', () => {
    const totalPages = Math.ceil(filteredProductItems.length / PRODUCTS_PAGE_SIZE);
    if (productsPage < totalPages) { productsPage++; renderProductsPage(); }
  });

  document.getElementById('storage-gib-input')?.addEventListener('input', (e) => {
    const val = parseInt((e.target as HTMLInputElement).value, 10);
    blockStorageGiB = isNaN(val) || val < 1 ? 1 : Math.min(val, 65536);
    renderProductsPage();
  });
</script>
