---
// FilterPanel v3: drives available options from index.json (loaded client-side).
---

<style>
  /*
   * Below xl (1280px): panel becomes a fixed left drawer.
   * At xl+: panel is in normal grid flow as a sidebar card.
   */
  @media (max-width: 1023px) {
    #filter-panel-wrapper {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 50;
      width: 22rem;
      max-width: 90vw;
      overflow-y: auto;
      border-radius: 0;
      border-top: 0;
      border-bottom: 0;
      border-left: 0;
      box-shadow: 8px 0 32px -4px rgb(0 0 0 / 0.2);
      transform: translateX(-100%);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #filter-panel-wrapper.drawer-open {
      transform: translateX(0);
    }
  }

  /* Thin scrollbar affordance for scrollable filter lists */
  .filter-scroll::-webkit-scrollbar { width: 4px; }
  .filter-scroll::-webkit-scrollbar-track { background: transparent; }
  .filter-scroll::-webkit-scrollbar-thumb { background-color: #d1d5db; border-radius: 2px; }

  /* On very small screens move the FAB to bottom-left so it doesn't
     overlap the compare checkboxes that live in the right column of
     every mobile card row. */
  @media (max-width: 639px) {
    #filter-fab {
      right: auto;
      left: 1.5rem;
    }
  }
</style>

<!-- FAB: visible on mobile/tablet only (< xl) -->
<button
  id="filter-fab"
  type="button"
  aria-controls="filter-panel-wrapper"
  aria-expanded="false"
  aria-label="Open filters"
  class="lg:hidden fixed bottom-6 right-6 z-40 inline-flex items-center gap-2 px-4 py-3 bg-primary-600 text-white text-sm font-semibold rounded-full shadow-lg hover:bg-primary-700 active:bg-primary-800 transition-colors"
>
  <svg class="h-4 w-4 shrink-0" aria-hidden="true" viewBox="0 0 20 20" fill="currentColor">
    <path fill-rule="evenodd" d="M2.628 1.601C5.028 1.206 7.49 1 10 1s4.973.206 7.372.601a.75.75 0 01.628.74v2.288a2.25 2.25 0 01-.659 1.59l-4.682 4.683a2.25 2.25 0 00-.659 1.59v3.037c0 .684-.31 1.33-.844 1.757l-1.937 1.55A.75.75 0 018 18.25v-5.757a2.25 2.25 0 00-.659-1.591L2.659 6.22A2.25 2.25 0 012 4.629V2.34a.75.75 0 01.628-.74z" clip-rule="evenodd" />
  </svg>
  Filters
  <span
    id="fab-count"
    class="hidden min-w-[1.25rem] h-5 px-1 bg-white text-primary-600 text-xs font-bold rounded-full items-center justify-center leading-none"
    aria-label="active filters"
  >0</span>
</button>

<!-- Backdrop: visible when drawer is open on mobile/tablet -->
<div id="filter-backdrop" class="lg:hidden hidden fixed inset-0 bg-black/40 z-40"></div>

<!-- Filter panel: drawer on mobile/tablet, sidebar card on xl+ -->
<div id="filter-panel-wrapper" class="bg-white border border-gray-200 shadow-xs lg:rounded-lg lg:h-full">

  <!-- Drawer header (mobile/tablet only) -->
  <div class="lg:hidden sticky top-0 bg-white z-10 flex items-center justify-between px-4 py-3 border-b border-gray-100">
    <div class="flex items-center gap-2">
      <h2 class="text-base font-semibold text-gray-900">Filters</h2>
      <span class="filter-count-badge hidden px-2 py-0.5 bg-primary-100 text-primary-700 text-xs font-semibold rounded-full"></span>
    </div>
    <button
      id="filter-close"
      type="button"
      aria-label="Close filters"
      class="p-1.5 rounded-md text-gray-400 hover:text-gray-900 hover:bg-gray-100 transition-colors"
    >
      <svg class="h-5 w-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Desktop header (xl+ only) -->
  <div class="hidden lg:flex items-center gap-2 px-4 pt-4 pb-0">
    <h2 class="text-base font-semibold text-gray-900">Filters</h2>
    <span class="filter-count-badge hidden px-2 py-0.5 bg-primary-100 text-primary-700 text-xs font-semibold rounded-full"></span>
  </div>

  <!-- Filter controls -->
  <div class="p-4 space-y-5" id="filter-panel">

    <!-- Cloud Providers -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Cloud Providers</label>
      <div class="space-y-2" id="provider-checkboxes">
        {[1,2,3,4].map(() => (
          <div class="h-5 bg-gray-100 rounded-sm animate-pulse w-28"></div>
        ))}
      </div>
    </div>

    <!-- Region (shown for all categories) -->
    <div id="region-filter-section">
      <div class="flex items-center justify-between mb-2">
        <label class="block text-sm font-medium text-gray-700">Region</label>
        <div class="flex gap-2 text-xs">
          <button type="button" id="region-select-all" class="text-primary-600 hover:underline font-medium">All</button>
          <span class="text-gray-300">|</span>
          <button type="button" id="region-clear-all" class="text-gray-700 hover:underline">None</button>
        </div>
      </div>
      <!-- Prominent search input -->
      <div class="relative mb-2">
        <label for="region-search" class="sr-only">Search regions</label>
        <input
          type="text"
          id="region-search"
          placeholder="Search regions..."
          class="w-full pl-8 pr-3 py-2 text-sm border border-gray-300 rounded-md bg-white outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-shadow"
        />
        <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none">
          <svg class="h-4 w-4 text-gray-400" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
      <div
        class="filter-scroll space-y-0.5 max-h-44 overflow-y-auto rounded-md border border-gray-100 p-2 bg-gray-50/60"
        id="region-checkboxes"
      >
        <div class="text-xs text-gray-400 italic">Loading regions...</div>
      </div>
    </div>

    <!-- Compute-only filters (hidden when a non-compute category is active) -->
    <div id="compute-only-filters" class="space-y-5">

    <!-- Instance Family -->
    <div id="family-filter-section">
      <label class="block text-sm font-medium text-gray-700 mb-2">Instance Family</label>
      <div
        class="filter-scroll space-y-1 max-h-52 overflow-y-auto rounded-md border border-gray-100 p-2 bg-gray-50/60"
        id="family-checkboxes"
      >
        <div class="text-xs text-gray-400 italic">Loading families...</div>
      </div>
    </div>

    <!-- Pricing Term — grouped box -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Pricing Term</label>
      <div class="bg-gray-50 rounded-lg border border-gray-100 p-3 space-y-2">
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="commitmentTerm" value="on-demand" checked
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">On-Demand</span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="commitmentTerm" value="1yr"
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">1-Year Reserved</span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="commitmentTerm" value="3yr"
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">3-Year Reserved</span>
        </label>
      </div>
    </div>

    <!-- vCPU Range — with live value display -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <label class="block text-sm font-medium text-gray-700">vCPU Count</label>
        <span id="vcpu-display" class="text-xs text-gray-500 tabular-nums">1 – 1024</span>
      </div>
      <div class="flex items-center gap-2">
        <input type="number" name="minVCPU" id="min-vcpu" placeholder="Min"
          min="1" max="1024" value="1"
          aria-label="Minimum vCPU count"
          class="w-full rounded-md border border-gray-300 text-sm px-2 py-1.5 text-center focus:ring-1 focus:ring-primary-500 focus:border-primary-500" />
        <span class="text-gray-400 shrink-0 text-sm" aria-hidden="true">–</span>
        <input type="number" name="maxVCPU" id="max-vcpu" placeholder="Max"
          min="1" max="1024" value="1024"
          aria-label="Maximum vCPU count"
          class="w-full rounded-md border border-gray-300 text-sm px-2 py-1.5 text-center focus:ring-1 focus:ring-primary-500 focus:border-primary-500" />
      </div>
    </div>

    <!-- Memory Range — with live value display -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <label class="block text-sm font-medium text-gray-700">Memory (GiB)</label>
        <span id="mem-display" class="text-xs text-gray-500 tabular-nums">0.5 – 65536</span>
      </div>
      <div class="flex items-center gap-2">
        <input type="number" name="minMemory" id="min-memory" placeholder="Min"
          min="0.5" max="65536" value="0.5"
          aria-label="Minimum memory in GiB"
          class="w-full rounded-md border border-gray-300 text-sm px-2 py-1.5 text-center focus:ring-1 focus:ring-primary-500 focus:border-primary-500" />
        <span class="text-gray-400 shrink-0 text-sm" aria-hidden="true">–</span>
        <input type="number" name="maxMemory" id="max-memory" placeholder="Max"
          min="0.5" max="65536" value="65536"
          aria-label="Maximum memory in GiB"
          class="w-full rounded-md border border-gray-300 text-sm px-2 py-1.5 text-center focus:ring-1 focus:ring-primary-500 focus:border-primary-500" />
      </div>
    </div>

    <!-- Max Hourly Price — with $ prefix -->
    <div>
      <label for="max-price" class="block text-sm font-medium text-gray-700 mb-1.5">Max Price (USD/hr)</label>
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 text-sm pointer-events-none">$</span>
        <input type="number" name="maxPrice" id="max-price" placeholder="e.g. 2.00"
          min="0" step="0.01"
          class="w-full pl-6 pr-2 py-1.5 rounded-md border border-gray-300 text-sm focus:ring-1 focus:ring-primary-500 focus:border-primary-500" />
      </div>
    </div>

    <!-- GPU Only -->
    <div>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" id="gpu-only"
          class="rounded-sm border-gray-300 text-primary-600 focus:ring-primary-500" />
        <span class="text-sm text-gray-700">GPU instances only</span>
      </label>
    </div>

    <!-- Tenancy — grouped box -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Tenancy</label>
      <div class="bg-gray-50 rounded-lg border border-gray-100 p-3 space-y-2">
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="tenancy" value="any" checked
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">Any</span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="tenancy" value="shared"
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">Shared</span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="tenancy" value="dedicated"
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">Dedicated Instance</span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="tenancy" value="host"
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">Dedicated Host</span>
        </label>
      </div>
    </div>

    <!-- Architecture — grouped box -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Architecture</label>
      <div class="bg-gray-50 rounded-lg border border-gray-100 p-3 space-y-2">
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="architecture" value="any" checked
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">Any</span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="architecture" value="x86_64"
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">x86_64</span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="architecture" value="arm64"
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">arm64</span>
        </label>
      </div>
    </div>

    <!-- Operating System -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Operating System</label>
      <div class="bg-gray-50 rounded-lg border border-gray-100 p-3 space-y-2">
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="operatingSystem" value="Linux" checked
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">Linux</span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="operatingSystem" value="Windows"
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">Windows</span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="operatingSystem" value="RHEL"
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">RHEL</span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="operatingSystem" value="macOS"
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">macOS <span class="text-gray-400 text-xs">(Mac only)</span></span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="operatingSystem" value="any"
            class="border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-700">Any</span>
        </label>
      </div>
    </div>

    </div><!-- /compute-only-filters -->

    <!-- Action Buttons -->
    <div class="pt-4 border-t border-gray-200">
      <button
        type="button"
        id="clear-filters"
        class="w-full bg-white text-gray-700 py-2 px-4 rounded-md border border-gray-300 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 text-sm font-medium transition-colors"
      >
        Clear All
      </button>
    </div>

  </div>
</div>

<script>
  import type { V3Index, V3ProviderEntry } from '../types';

  let indexData: V3Index | null = null;
  let currentCategory: string = (() => {
    const p = new URLSearchParams(window.location.search).get('cat');
    return p ?? 'compute';
  })();

  // Tracks user's explicit intent so selections survive provider list re-renders
  const uncheckedFamilies = new Set<string>(); // families the user has manually unchecked
  const checkedRegions    = new Set<string>(); // regions the user has manually checked

  let activePresetId: string | null = null;
  let activePresetSort: { field: string; dir: 'asc' | 'desc' } | null = null;

  // ── Drawer / FAB ─────────────────────────────────────────────────────────────

  const fab       = document.getElementById('filter-fab');
  const backdrop  = document.getElementById('filter-backdrop');
  const wrapper   = document.getElementById('filter-panel-wrapper');
  const closeBtn  = document.getElementById('filter-close');

  function openDrawer() {
    wrapper?.classList.add('drawer-open');
    backdrop?.classList.remove('hidden');
    if (window.innerWidth < 1024) document.body.style.overflow = 'hidden';
    fab?.setAttribute('aria-expanded', 'true');
  }

  function closeDrawer() {
    wrapper?.classList.remove('drawer-open');
    backdrop?.classList.add('hidden');
    document.body.style.overflow = '';
    fab?.setAttribute('aria-expanded', 'false');
  }

  fab?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

  // ── Filter count badge ───────────────────────────────────────────────────────

  function countActiveFilters(): number {
    let n = 0;

    const total   = document.querySelectorAll('input[name="provider"]').length;
    const checked = document.querySelectorAll('input[name="provider"]:checked').length;
    if (total > 0 && checked < total) n++;

    const term = document.querySelector<HTMLInputElement>('input[name="commitmentTerm"]:checked')?.value;
    if (term && term !== 'on-demand') n++;

    const arch = document.querySelector<HTMLInputElement>('input[name="architecture"]:checked')?.value;
    if (arch && arch !== 'any') n++;

    const os = document.querySelector<HTMLInputElement>('input[name="operatingSystem"]:checked')?.value;
    if (os && os !== 'Linux') n++;

    const tenancy = document.querySelector<HTMLInputElement>('input[name="tenancy"]:checked')?.value;
    if (tenancy && tenancy !== 'any') n++;

    const minV = parseFloat((document.getElementById('min-vcpu') as HTMLInputElement)?.value || '1');
    const maxV = parseFloat((document.getElementById('max-vcpu') as HTMLInputElement)?.value || '1024');
    if (minV > 1)    n++;
    if (maxV < 1024) n++;

    const minM = parseFloat((document.getElementById('min-memory') as HTMLInputElement)?.value || '0.5');
    const maxM = parseFloat((document.getElementById('max-memory') as HTMLInputElement)?.value || '65536');
    if (minM > 0.5)    n++;
    if (maxM < 65536)  n++;

    const maxP = (document.getElementById('max-price') as HTMLInputElement)?.value;
    if (maxP && parseFloat(maxP) > 0) n++;

    if ((document.getElementById('gpu-only') as HTMLInputElement)?.checked) n++;

    if (document.querySelectorAll('input[name="region"]:checked').length > 0) n++;

    return n;
  }

  function updateBadges() {
    const n = countActiveFilters();
    const label = n === 1 ? '1 active' : `${n} active`;

    document.querySelectorAll<HTMLElement>('.filter-count-badge').forEach((el) => {
      el.textContent = label;
      el.classList.toggle('hidden', n === 0);
      el.classList.toggle('inline-flex', n > 0);
    });

    const fabCount = document.getElementById('fab-count');
    if (fabCount) {
      fabCount.textContent = String(n);
      fabCount.classList.toggle('hidden', n === 0);
      fabCount.classList.toggle('inline-flex', n > 0);
    }
  }

  // ── Range value display ──────────────────────────────────────────────────────

  function updateRangeDisplays() {
    const minV = (document.getElementById('min-vcpu') as HTMLInputElement)?.value || '1';
    const maxV = (document.getElementById('max-vcpu') as HTMLInputElement)?.value || '1024';
    const vcpuEl = document.getElementById('vcpu-display');
    if (vcpuEl) vcpuEl.textContent = `${minV} – ${maxV}`;

    const minM = (document.getElementById('min-memory') as HTMLInputElement)?.value || '0.5';
    const maxM = (document.getElementById('max-memory') as HTMLInputElement)?.value || '65536';
    const memEl = document.getElementById('mem-display');
    if (memEl) memEl.textContent = `${minM} – ${maxM}`;
  }

  let filterDebounceTimer: ReturnType<typeof setTimeout> | null = null;
  function debouncedApply() {
    if (filterDebounceTimer) clearTimeout(filterDebounceTimer);
    filterDebounceTimer = setTimeout(() => { applyFilters(); updateBadges(); }, 350);
  }

  ['min-vcpu', 'max-vcpu', 'min-memory', 'max-memory'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', () => { updateRangeDisplays(); debouncedApply(); });
  });

  document.getElementById('max-price')?.addEventListener('input', debouncedApply);

  // Auto-apply on static filter changes
  document.querySelectorAll<HTMLInputElement>('input[name="commitmentTerm"]').forEach((el) => {
    el.addEventListener('change', () => { applyFilters(); updateBadges(); });
  });
  document.querySelectorAll<HTMLInputElement>('input[name="architecture"]').forEach((el) => {
    el.addEventListener('change', () => { applyFilters(); updateBadges(); });
  });
  document.querySelectorAll<HTMLInputElement>('input[name="operatingSystem"]').forEach((el) => {
    el.addEventListener('change', () => { applyFilters(); updateBadges(); });
  });
  document.querySelectorAll<HTMLInputElement>('input[name="tenancy"]').forEach((el) => {
    el.addEventListener('change', () => { applyFilters(); updateBadges(); });
  });
  document.getElementById('gpu-only')?.addEventListener('change', () => { applyFilters(); updateBadges(); });

  // ── URL state persistence ────────────────────────────────────────────────────

  function writeFilterStateToURL() {
    const params = new URLSearchParams();

    const allProviders = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="provider"]')).map(el => el.value);
    const checked = getSelectedProviders();
    if (checked.length > 0 && checked.length < allProviders.length) {
      params.set('providers', checked.join(','));
    }

    const term = document.querySelector<HTMLInputElement>('input[name="commitmentTerm"]:checked')?.value;
    if (term && term !== 'on-demand') params.set('term', term);

    const arch = document.querySelector<HTMLInputElement>('input[name="architecture"]:checked')?.value;
    if (arch && arch !== 'any') params.set('arch', arch);

    const os = document.querySelector<HTMLInputElement>('input[name="operatingSystem"]:checked')?.value;
    if (os && os !== 'Linux') params.set('os', os);

    const ten = document.querySelector<HTMLInputElement>('input[name="tenancy"]:checked')?.value;
    if (ten && ten !== 'any') params.set('tenancy', ten);

    const minV = (document.getElementById('min-vcpu') as HTMLInputElement)?.value;
    const maxV = (document.getElementById('max-vcpu') as HTMLInputElement)?.value;
    if (minV && parseFloat(minV) > 1) params.set('minVCPU', minV);
    if (maxV && parseFloat(maxV) < 1024) params.set('maxVCPU', maxV);

    const minM = (document.getElementById('min-memory') as HTMLInputElement)?.value;
    const maxM = (document.getElementById('max-memory') as HTMLInputElement)?.value;
    if (minM && parseFloat(minM) > 0.5) params.set('minMem', minM);
    if (maxM && parseFloat(maxM) < 65536) params.set('maxMem', maxM);

    const maxP = (document.getElementById('max-price') as HTMLInputElement)?.value;
    if (maxP && parseFloat(maxP) > 0) params.set('maxPrice', maxP);

    if ((document.getElementById('gpu-only') as HTMLInputElement)?.checked) params.set('gpu', '1');

    const checkedRegionsList = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="region"]:checked')).map(el => el.value);
    if (checkedRegionsList.length > 0) params.set('regions', checkedRegionsList.join(','));

    // Persist unchecked families (shorter URL than listing all checked ones)
    if (uncheckedFamilies.size > 0) {
      params.set('excludeFamilies', Array.from(uncheckedFamilies).join(','));
    }

    if (activePresetId) params.set('preset', activePresetId);
    if (activePresetSort) {
      params.set('sortField', activePresetSort.field);
      params.set('sortDir', activePresetSort.dir);
    }

    const newURL = new URL(window.location.href);
    newURL.search = params.toString();
    window.history.replaceState({}, '', newURL.toString());
  }

  function readURLState() {
    const params = new URLSearchParams(window.location.search);
    if (!params.toString()) return;

    const providers = params.get('providers');
    if (providers) {
      const providerList = providers.split(',');
      document.querySelectorAll<HTMLInputElement>('input[name="provider"]').forEach(cb => {
        cb.checked = providerList.includes(cb.value);
      });
      if (indexData) {
        const selected = indexData.providers.filter(p => providerList.includes(p.id));
        populateFamilies(selected);
        populateRegions(selected);
      }
    }

    const term = params.get('term');
    if (term) {
      const radio = document.querySelector<HTMLInputElement>(`input[name="commitmentTerm"][value="${term}"]`);
      if (radio) radio.checked = true;
    }

    const arch = params.get('arch');
    if (arch) {
      const radio = document.querySelector<HTMLInputElement>(`input[name="architecture"][value="${arch}"]`);
      if (radio) radio.checked = true;
    }

    const os = params.get('os');
    if (os) {
      const radio = document.querySelector<HTMLInputElement>(`input[name="operatingSystem"][value="${os}"]`);
      if (radio) radio.checked = true;
    }

    const ten = params.get('tenancy');
    if (ten) {
      const radio = document.querySelector<HTMLInputElement>(`input[name="tenancy"][value="${ten}"]`);
      if (radio) radio.checked = true;
    }

    const minVCPU = params.get('minVCPU');
    const maxVCPU = params.get('maxVCPU');
    if (minVCPU) (document.getElementById('min-vcpu') as HTMLInputElement).value = minVCPU;
    if (maxVCPU) (document.getElementById('max-vcpu') as HTMLInputElement).value = maxVCPU;

    const minMem = params.get('minMem');
    const maxMem = params.get('maxMem');
    if (minMem) (document.getElementById('min-memory') as HTMLInputElement).value = minMem;
    if (maxMem) (document.getElementById('max-memory') as HTMLInputElement).value = maxMem;

    const maxPrice = params.get('maxPrice');
    if (maxPrice) (document.getElementById('max-price') as HTMLInputElement).value = maxPrice;

    if (params.get('gpu') === '1') {
      const gpuCb = document.getElementById('gpu-only') as HTMLInputElement;
      if (gpuCb) gpuCb.checked = true;
    }

    const regions = params.get('regions');
    if (regions) {
      const regionList = regions.split(',');
      regionList.forEach(r => checkedRegions.add(r));
      document.querySelectorAll<HTMLInputElement>('input[name="region"]').forEach(cb => {
        cb.checked = regionList.includes(cb.value);
      });
    }

    const excludeFamilies = params.get('excludeFamilies');
    if (excludeFamilies) {
      const excludeList = excludeFamilies.split(',');
      excludeList.forEach(f => uncheckedFamilies.add(f));
      document.querySelectorAll<HTMLInputElement>('input[name="family"]').forEach(cb => {
        if (excludeList.includes(cb.value)) cb.checked = false;
      });
    }

    const presetId = params.get('preset');
    if (presetId) activePresetId = presetId;

    const sortField = params.get('sortField');
    const sortDir   = params.get('sortDir');
    if (sortField) activePresetSort = { field: sortField, dir: sortDir === 'desc' ? 'desc' : 'asc' };

    updateRangeDisplays();
    applyFilters();
    updateBadges();
  }

  // ── Index loading ────────────────────────────────────────────────────────────

  // ── Category visibility ──────────────────────────────────────────────────────

  function setComputeFiltersVisible(visible: boolean) {
    const el = document.getElementById('compute-only-filters');
    if (el) el.style.display = visible ? '' : 'none';
  }

  window.addEventListener('serviceCategoryChanged', (event: Event) => {
    const { category } = (event as CustomEvent<{ category: string }>).detail;
    currentCategory = category;
    setComputeFiltersVisible(category === 'compute');
  });

  window.addEventListener('computeProviderCountsUpdated', (event: Event) => {
    if (currentCategory !== 'compute') return;
    const { providerCounts } = (event as CustomEvent<{ providerCounts: Record<string, number> }>).detail;
    const container = document.getElementById('provider-checkboxes');
    if (!container) return;
    container.querySelectorAll<HTMLLabelElement>('label').forEach((label) => {
      const checkbox = label.querySelector<HTMLInputElement>('input[name="provider"]');
      if (!checkbox) return;
      const countSpan = label.querySelector<HTMLElement>('span:last-child');
      if (countSpan) {
        const count = providerCounts[checkbox.value] ?? 0;
        countSpan.textContent = `(${count.toLocaleString()})`;
      }
    });
  });

  // Apply on initial load if URL has a non-compute category
  (() => {
    const initCat = new URLSearchParams(window.location.search).get('cat');
    if (initCat && initCat !== 'compute') setComputeFiltersVisible(false);
  })();

  window.addEventListener('indexLoaded', (event: Event) => {
    const { index } = (event as CustomEvent<{ index: V3Index }>).detail;
    indexData = index;
    populateProviders(index);
    populateFamilies(index.providers);
    populateRegions(index.providers);
    updateBadges();
    readURLState();
  });

  window.addEventListener('productProvidersLoaded', (event: Event) => {
    const { providerCounts } = (event as CustomEvent<{ providerCounts: Record<string, number> | null }>).detail;
    const container = document.getElementById('provider-checkboxes');
    if (!container) return;
    container.querySelectorAll<HTMLLabelElement>('label').forEach((label) => {
      const checkbox = label.querySelector<HTMLInputElement>('input[name="provider"]');
      if (!checkbox) return;
      const providerId = checkbox.value;
      const countSpan = label.querySelector<HTMLElement>('span:last-child');
      if (providerCounts === null) {
        const provider = indexData?.providers.find((p) => p.id === providerId);
        if (countSpan) countSpan.textContent = provider ? `(${provider.instanceCount.toLocaleString()})` : '';
        label.style.display = '';
      } else {
        const count = providerCounts[providerId] ?? 0;
        if (countSpan) countSpan.textContent = `(${count.toLocaleString()})`;
        label.style.display = count === 0 ? 'none' : '';
      }
    });
  });

  function populateProviders(index: V3Index) {
    const container = document.getElementById('provider-checkboxes');
    if (!container) return;

    container.innerHTML = '';
    index.providers.forEach((provider) => {
      const label = document.createElement('label');
      label.className = 'flex items-center';
      label.innerHTML = `
        <input type="checkbox" name="provider" value="${provider.id}" checked
          class="rounded-sm border-gray-300 text-primary-600 focus:ring-primary-500" />
        <span class="ml-2 text-sm text-gray-600 uppercase">${provider.id}</span>
        <span class="ml-1 text-xs text-gray-400">(${provider.instanceCount.toLocaleString()})</span>
      `;
      container.appendChild(label);
    });

    container.querySelectorAll('input[name="provider"]').forEach((input) => {
      input.addEventListener('change', () => {
        if (!indexData) return;
        const selectedIds = getSelectedProviders();
        const selected = indexData.providers.filter((p) => selectedIds.includes(p.id));
        populateFamilies(selected);
        populateRegions(selected);
        applyFilters();
        updateBadges();
      });
    });
  }

  function populateFamilies(providers: V3ProviderEntry[]) {
    const container = document.getElementById('family-checkboxes');
    if (!container) return;

    if (providers.length === 0) {
      container.innerHTML = '<div class="text-xs text-gray-400 italic">No providers selected</div>';
      return;
    }

    container.innerHTML = '';
    providers.forEach((provider) => {
      const heading = document.createElement('div');
      heading.className = 'text-xs font-semibold text-gray-500 uppercase tracking-wider mt-2 mb-1 first:mt-0';
      heading.textContent = provider.id.toUpperCase();
      container.appendChild(heading);

      provider.families.forEach((family) => {
        const label = document.createElement('label');
        label.className = 'flex items-center ml-2 cursor-pointer';
        label.innerHTML = `
          <input type="checkbox" name="family" value="${provider.id}:${family.id}" checked
            class="rounded-sm border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-2 text-sm text-gray-600">${family.id}</span>
          <span class="ml-1 text-xs text-gray-400">(${family.count})</span>
        `;
        container.appendChild(label);
      });
    });

    // Restore explicit unchecks and wire up live tracking + auto-apply
    container.querySelectorAll<HTMLInputElement>('input[name="family"]').forEach((cb) => {
      if (uncheckedFamilies.has(cb.value)) cb.checked = false;
      cb.addEventListener('change', () => {
        if (cb.checked) uncheckedFamilies.delete(cb.value);
        else uncheckedFamilies.add(cb.value);
        applyFilters();
        updateBadges();
      });
    });
  }

  function populateRegions(providers: V3ProviderEntry[]) {
    const container = document.getElementById('region-checkboxes');
    if (!container) return;

    container.innerHTML = '';
    let hasRegions = false;

    providers.forEach((provider) => {
      if (!provider.regions?.length) return;
      hasRegions = true;

      const heading = document.createElement('div');
      heading.className = 'region-provider-heading text-xs font-semibold text-gray-500 uppercase tracking-wider mt-2 mb-0.5 first:mt-0';
      heading.dataset.provider = provider.id;
      heading.textContent = provider.id.toUpperCase();
      container.appendChild(heading);

      [...provider.regions].sort().forEach((region) => {
        const label = document.createElement('label');
        label.className = 'region-item flex items-center ml-2 py-0.5 cursor-pointer';
        label.dataset.region = region;
        label.dataset.provider = provider.id;
        label.innerHTML = `
          <input type="checkbox" name="region" value="${region}"
            class="h-3 w-3 rounded-sm border-gray-300 text-primary-600 focus:ring-primary-500" />
          <span class="ml-1.5 text-xs text-gray-600 font-mono">${region}</span>
        `;
        container.appendChild(label);
      });
    });

    if (!hasRegions) {
      container.innerHTML = '<div class="text-xs text-gray-400 italic">No regions available</div>';
    }

    // Restore explicit checks and wire up live tracking + auto-apply
    container.querySelectorAll<HTMLInputElement>('input[name="region"]').forEach((cb) => {
      if (checkedRegions.has(cb.value)) cb.checked = true;
      cb.addEventListener('change', () => {
        if (cb.checked) checkedRegions.add(cb.value);
        else checkedRegions.delete(cb.value);
        applyFilters();
        updateBadges();
      });
    });
  }

  // ── Region search ────────────────────────────────────────────────────────────

  document.getElementById('region-search')?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
    const container = document.getElementById('region-checkboxes');
    if (!container) return;

    let lastHeading: HTMLElement | null = null;
    let headingHasVisible = false;

    container.querySelectorAll<HTMLElement>('.region-item, .region-provider-heading').forEach((el) => {
      if (el.classList.contains('region-provider-heading')) {
        if (lastHeading) lastHeading.style.display = headingHasVisible ? '' : 'none';
        lastHeading = el;
        headingHasVisible = false;
        el.style.display = '';
      } else {
        const region = el.dataset.region ?? '';
        const visible = !q || region.toLowerCase().includes(q);
        el.style.display = visible ? '' : 'none';
        if (visible) headingHasVisible = true;
      }
    });
    if (lastHeading) (lastHeading as HTMLElement).style.display = headingHasVisible ? '' : 'none';
  });

  document.getElementById('region-select-all')?.addEventListener('click', () => {
    document.querySelectorAll<HTMLInputElement>('input[name="region"]').forEach((cb) => {
      cb.checked = true;
      checkedRegions.add(cb.value);
    });
    applyFilters();
    updateBadges();
  });

  document.getElementById('region-clear-all')?.addEventListener('click', () => {
    document.querySelectorAll<HTMLInputElement>('input[name="region"]').forEach((cb) => {
      cb.checked = false;
      checkedRegions.delete(cb.value);
    });
    applyFilters();
    updateBadges();
  });

  // ── Helpers ──────────────────────────────────────────────────────────────────

  function getSelectedProviders(): string[] {
    return Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="provider"]:checked')
    ).map((el) => el.value);
  }

  // ── Apply / Clear ────────────────────────────────────────────────────────────

  document.getElementById('clear-filters')?.addEventListener('click', () => {
    clearFilters();
    updateBadges();
  });

  function applyFilters() {
    const providers = getSelectedProviders();

    const families = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="family"]:checked')
    ).map((el) => {
      const [provider, family] = el.value.split(':');
      return { provider, family };
    });

    const commitmentTerm = (
      document.querySelector<HTMLInputElement>('input[name="commitmentTerm"]:checked')?.value ??
      'on-demand'
    ) as 'on-demand' | '1yr' | '3yr';

    const architecture =
      document.querySelector<HTMLInputElement>('input[name="architecture"]:checked')?.value ?? 'any';

    const operatingSystem =
      document.querySelector<HTMLInputElement>('input[name="operatingSystem"]:checked')?.value ?? 'Linux';

    const tenancy =
      document.querySelector<HTMLInputElement>('input[name="tenancy"]:checked')?.value ?? 'any';

    const minVCPU   = parseFloat((document.getElementById('min-vcpu')   as HTMLInputElement)?.value || '1');
    const maxVCPU   = parseFloat((document.getElementById('max-vcpu')   as HTMLInputElement)?.value || '1024');
    const minMemory = parseFloat((document.getElementById('min-memory') as HTMLInputElement)?.value || '0.5');
    const maxMemory = parseFloat((document.getElementById('max-memory') as HTMLInputElement)?.value || '65536');
    const maxPriceRaw = (document.getElementById('max-price') as HTMLInputElement)?.value;
    const maxPrice = maxPriceRaw ? parseFloat(maxPriceRaw) : Infinity;
    const gpuOnly  = (document.getElementById('gpu-only') as HTMLInputElement)?.checked ?? false;

    const regions = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="region"]:checked')
    ).map((el) => el.value);

    window.dispatchEvent(
      new CustomEvent('filtersChanged', {
        detail: {
          providers, families, commitmentTerm, architecture, operatingSystem, tenancy, minVCPU, maxVCPU,
          minMemory, maxMemory, maxPrice, gpuOnly, regions, filterCount: countActiveFilters(),
          ...(activePresetSort ? { sortField: activePresetSort.field, sortDir: activePresetSort.dir } : {}),
        },
      })
    );
    writeFilterStateToURL();
  }

  function resetFilterInputsToDefaults() {
    uncheckedFamilies.clear();
    checkedRegions.clear();

    document.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:not([name="region"])').forEach((el) => {
      el.checked = true;
    });
    document.querySelectorAll<HTMLInputElement>('input[name="region"]').forEach((el) => {
      el.checked = false;
    });
    const gpuCb = document.getElementById('gpu-only') as HTMLInputElement;
    if (gpuCb) gpuCb.checked = false;

    const regionSearchEl = document.getElementById('region-search') as HTMLInputElement | null;
    if (regionSearchEl) regionSearchEl.value = '';
    document.querySelectorAll<HTMLElement>('#region-checkboxes .region-item, #region-checkboxes .region-provider-heading').forEach((el) => {
      el.style.display = '';
    });

    const odRadio = document.querySelector<HTMLInputElement>('input[name="commitmentTerm"][value="on-demand"]');
    if (odRadio) odRadio.checked = true;

    const anyArch = document.querySelector<HTMLInputElement>('input[name="architecture"][value="any"]');
    if (anyArch) anyArch.checked = true;

    const linuxOS = document.querySelector<HTMLInputElement>('input[name="operatingSystem"][value="Linux"]');
    if (linuxOS) linuxOS.checked = true;

    const anyTenancy = document.querySelector<HTMLInputElement>('input[name="tenancy"][value="any"]');
    if (anyTenancy) anyTenancy.checked = true;

    const maxPriceInput = document.getElementById('max-price') as HTMLInputElement;
    if (maxPriceInput) maxPriceInput.value = '';

    const minVCPU = document.getElementById('min-vcpu') as HTMLInputElement;
    if (minVCPU) minVCPU.value = '1';
    const maxVCPU = document.getElementById('max-vcpu') as HTMLInputElement;
    if (maxVCPU) maxVCPU.value = '1024';
    const minMem = document.getElementById('min-memory') as HTMLInputElement;
    if (minMem) minMem.value = '0.5';
    const maxMem = document.getElementById('max-memory') as HTMLInputElement;
    if (maxMem) maxMem.value = '65536';

    updateRangeDisplays();
  }

  function clearFilters() {
    if (activePresetId !== null) {
      activePresetId = null;
      activePresetSort = null;
      window.dispatchEvent(new CustomEvent('presetDeactivated'));
      window.dispatchEvent(new CustomEvent('requestResetSort'));
    }
    resetFilterInputsToDefaults();
    applyFilters();
    window.history.replaceState({}, '', window.location.pathname);
  }

  window.addEventListener('requestClearFilters', () => {
    clearFilters();
    updateBadges();
  });

  window.addEventListener('requestPreset', (event: Event) => {
    const { id, filters, sort } = (event as CustomEvent<{
      id: string;
      filters: {
        arch?: string;
        term?: string;
        gpuOnly?: boolean;
        minVCPU?: number;
        maxVCPU?: number;
        minMemory?: number;
        maxMemory?: number;
      };
      sort: { field: string; dir: 'asc' | 'desc' };
    }>).detail;

    activePresetId   = id;
    activePresetSort = sort;

    // Reset all inputs to defaults, then apply preset overrides
    resetFilterInputsToDefaults();

    if (filters.arch) {
      const radio = document.querySelector<HTMLInputElement>(`input[name="architecture"][value="${filters.arch}"]`);
      if (radio) radio.checked = true;
    }

    if (filters.term) {
      const radio = document.querySelector<HTMLInputElement>(`input[name="commitmentTerm"][value="${filters.term}"]`);
      if (radio) radio.checked = true;
    }

    if (filters.gpuOnly) {
      const gpuCb = document.getElementById('gpu-only') as HTMLInputElement;
      if (gpuCb) gpuCb.checked = true;
    }

    if (filters.minVCPU !== undefined) {
      const el = document.getElementById('min-vcpu') as HTMLInputElement;
      if (el) el.value = String(filters.minVCPU);
    }
    if (filters.maxVCPU !== undefined) {
      const el = document.getElementById('max-vcpu') as HTMLInputElement;
      if (el) el.value = String(filters.maxVCPU);
    }
    if (filters.minMemory !== undefined) {
      const el = document.getElementById('min-memory') as HTMLInputElement;
      if (el) el.value = String(filters.minMemory);
    }
    if (filters.maxMemory !== undefined) {
      const el = document.getElementById('max-memory') as HTMLInputElement;
      if (el) el.value = String(filters.maxMemory);
    }

    updateRangeDisplays();
    applyFilters();
    updateBadges();
  });
</script>
