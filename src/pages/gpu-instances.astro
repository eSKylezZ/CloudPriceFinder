---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadAllInstances, fmtPrice } from '../lib/seo-instances';

const LABEL: Record<string, string> = { aws: 'AWS', azure: 'Azure', gcp: 'GCP', oci: 'OCI' };
const BADGE: Record<string, string> = {
  aws: 'bg-orange-50 text-orange-700',
  azure: 'bg-blue-50 text-blue-700',
  gcp: 'bg-green-50 text-green-700',
  oci: 'bg-red-50 text-red-700',
};

const top20 = loadAllInstances()
  .filter(i => i.gpu != null)
  .sort((a, b) => a.priceUSD_hourly - b.priceUSD_hourly)
  .slice(0, 20);

const title = 'GPU Cloud Instances Price Comparison — CloudPriceFinder';
const description =
  'Compare GPU cloud instance prices across AWS, Azure, GCP, and Oracle Cloud. Includes NVIDIA A100, V100, H100, and T4. Sorted by on-demand hourly rate. Updated weekly.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'GPU Cloud Instances — Price Comparison',
  description,
  numberOfItems: top20.length,
  itemListElement: top20.map((inst, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${LABEL[inst.provider] ?? inst.provider} ${inst.instanceType} — ${fmtPrice(inst.priceUSD_hourly)}`,
    description: inst.gpu
      ? `${inst.gpu.count}× ${inst.gpu.type}, ${inst.vCPU} vCPU, ${inst.memoryGiB} GiB RAM`
      : '',
  })),
};
---

<BaseLayout {title} {description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} slot="head" />

  <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 2xl:px-16 py-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">
      GPU Cloud Instances — Price Comparison
    </h1>
    <p class="text-gray-600 mb-6 max-w-2xl">
      Top 20 cheapest GPU compute instances across AWS, Azure, Google Cloud, and Oracle Cloud,
      sorted by on-demand hourly price.
    </p>

    <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm mb-6">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider w-10">#</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Provider</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Instance</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">vCPU</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">RAM (GiB)</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">GPU</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">On-Demand/hr</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {top20.map((inst, i) => (
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-4 py-3 text-gray-400 text-xs">{i + 1}</td>
              <td class="px-4 py-3">
                <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold ${BADGE[inst.provider] ?? 'bg-gray-100 text-gray-700'}`}>
                  {LABEL[inst.provider] ?? inst.provider}
                </span>
              </td>
              <td class="px-4 py-3 font-mono font-medium text-gray-900">{inst.instanceType}</td>
              <td class="px-4 py-3 text-gray-700">{inst.vCPU ?? '—'}</td>
              <td class="px-4 py-3 text-gray-700">{inst.memoryGiB ?? '—'}</td>
              <td class="px-4 py-3 text-gray-600 text-xs">
                {inst.gpu ? `${inst.gpu.count}× ${inst.gpu.type}${inst.gpu.memoryGiB ? ` (${inst.gpu.memoryGiB} GiB)` : ''}` : '—'}
              </td>
              <td class="px-4 py-3 font-semibold text-emerald-700">{fmtPrice(inst.priceUSD_hourly)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <a
      href="/?gpu=1"
      class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-colors"
    >
      View all GPU instances →
    </a>
  </div>
</BaseLayout>
